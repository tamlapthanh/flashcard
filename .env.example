# Copy to .env.development.local (npm run dev) and .env.production.local (npm run build).
# These values are baked into the built site. The key is NOT a secret: it only keeps casual visitors out.
# Login: the server checks the users tab of the Google Sheet. Against a server with login off (AUTH=off) set VITE_LOGIN=false.
VITE_API_URL=http://localhost:8787
VITE_API_KEY=dev-key
VITE_LOGIN=true
