{
  "name": "flashmobile-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:cloudflare": "cross-env VITE_BASE=/ vite build --outDir dist",
    "build:github": "cross-env VITE_BASE=/flashcard/ vite build --outDir dist-github",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "deploy:github": "npm run build:github && npx gh-pages -d dist-github",
    "deploy": "npm run typecheck && npm run deploy:cloudflare && npm run deploy:github",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:watch": "playwright test -c playwright.watch.config.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
